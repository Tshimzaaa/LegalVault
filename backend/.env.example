# Copy to .env and fill in. Every var here maps 1:1 to app/core/config.py's Settings class —
# see that file for the full explanation of each one. In production (ENVIRONMENT=production),
# the app refuses to start if any of the secret-shaped values below are still "change-me".

# --- Database -----------------------------------------------------------
# Migration-time connection: must own the tables (Alembic runs ALTER TABLE / CREATE POLICY).
# Neon's default "<project>_owner" role works here.
DATABASE_URL=postgresql://user:password@host/dbname

# The app's actual request-serving connection. Must be a separate, restricted Postgres role
# WITHOUT the BYPASSRLS attribute, or row-level security silently has no effect. See
# backend/docs/architecture.md for the exact CREATE ROLE / GRANT statements, or run
# backend/scripts/print_runtime_role_sql.py to print them for a specific database name.
# Falls back to DATABASE_URL if unset — required in production.
RUNTIME_DATABASE_URL=postgresql://app_runtime:password@host/dbname

# --- Auth -----------------------------------------------------------------
# Generate real values with: python backend/scripts/generate_secrets.py
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Shared secret gating POST /auth/register (self-service firm onboarding). Different from
# OWNER_SECRET on purpose — see config.py's startup check.
REGISTER_SECRET=change-me
# Shared secret for the SaaS-owner console (cross-firm access). Must differ from REGISTER_SECRET.
OWNER_SECRET=change-me

# Firms are onboarded by the platform owner from the owner console. Public self-serve signup
# (POST /auth/register) is off unless this is set to true.
ALLOW_PUBLIC_REGISTRATION=false

# Fernet key encrypting third-party integration credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# --- Frontend / CORS --------------------------------------------------------
# The deployed frontend's real origin. Required in production — the app refuses to start
# with the localhost default once ENVIRONMENT=production.
FRONTEND_URL=http://localhost:5173

# --- Cloudflare R2 (object storage) -----------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=

# --- ClamAV (malware scanning on uploads) -----------------------------------
# See docker-compose.yml for local dev. In production this should point at a private-network
# ClamAV instance, not a publicly reachable one.
CLAMD_HOST=localhost
CLAMD_PORT=3310

# --- Documenso (self-hosted e-signature) ------------------------------------
# One shared instance for the whole platform — see docker-compose.yml's `documenso` service.
DOCUMENSO_API_URL=http://localhost:3000/api/v1
DOCUMENSO_API_KEY=change-me
# Configured on the Documenso side under Settings -> Webhooks, pointed at
# https://<backend-host>/webhooks/documenso, using this same value as the webhook secret.
DOCUMENSO_WEBHOOK_SECRET=change-me

# --- AI assistant ("Learned Friend") -----------------------------------------
# Which backend powers the AI chat assistant staff use.
#   ollama (default): a local model via https://ollama.com, no token needed —
#     just `ollama pull llama3.2:1b` and have `ollama serve` running.
#   github_models: GitHub's free-tier hosted inference, needs GITHUB_MODELS_TOKEN
#     (a PAT with `models: read`). Required in production if selected.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:1b
GITHUB_MODELS_TOKEN=change-me

# --- Background jobs (Celery + Redis) ---------------------------------------
# Broker for scheduled reminder jobs (matter due-date, contract expiry — see
# backend/app/tasks/). See docker-compose.yml's `redis` service for local dev.
# Required in production.
REDIS_URL=redis://localhost:6379/0

# --- Observability (optional) ------------------------------------------------
# Sentry error tracking. Leave unset to skip Sentry entirely — sentry_sdk.init() is
# simply not called (see app/main.py); not required in any environment, including
# production.
SENTRY_DSN=

# --- Environment -------------------------------------------------------------
# development | production — production enables the startup safety checks above, HSTS
# headers, and restricts CORS to FRONTEND_URL only (no localhost fallback).
ENVIRONMENT=development
