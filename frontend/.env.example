# Copy to .env and fill in.

# The backend API's origin. Defaults to http://127.0.0.1:8000 (see src/api/client.ts) if
# unset — required in production, where it must point at the real deployed backend.
VITE_API_BASE_URL=

# Optional — Sentry error tracking. Leave unset to skip Sentry entirely (see main.tsx);
# not required in any environment, including production.
VITE_SENTRY_DSN=
